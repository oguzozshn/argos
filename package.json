{
  "name": "argos",
  "version": "0.1.0",
  "description": "Argos — kişisel modüler masaüstü uygulaması",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "tipler": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node araclar/veri-testi.mts && node araclar/todoist-testi.mts && node araclar/asistan-testi.mts && node araclar/kural-testi.mts && node araclar/odak-testi.mts && node araclar/bosalt-testi.mts && node araclar/parite-testi.mts",
    "paket": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "chokidar": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "date-fns": "^4.4.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "electron@44.2.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "build": {
    "appId": "com.oguzozsahin.argos",
    "productName": "Argos",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "argos.config.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    }
  }
}
